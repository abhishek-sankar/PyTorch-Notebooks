# Environment Configuration for Java Migration System

# LLM Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here  # Optional alternative

# LLM Model Settings
LLM_MODEL=claude-3-sonnet-20240229
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000

# Maven Central API Configuration
MAVEN_CENTRAL_API_URL=https://search.maven.org/solrsearch/select
MAVEN_API_RATE_LIMIT_MS=100

# OpenRewrite Configuration
OPENREWRITE_MAVEN_PLUGIN_VERSION=5.3.0
OPENREWRITE_CLI_PATH=/usr/local/bin/rewrite  # Optional - for CLI usage

# System Configuration
JAVA_HOME=/path/to/java21
MAVEN_HOME=/path/to/maven
PATH=$JAVA_HOME/bin:$MAVEN_HOME/bin:$PATH

# Migration System Settings
DEFAULT_TIMEOUT_SECONDS=300
MAX_RETRY_ATTEMPTS=3
BACKUP_ENABLED=true
DRY_RUN_DEFAULT=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Performance Settings
COMMAND_TIMEOUT_SECONDS=1800
MAVEN_COMPILE_TIMEOUT=600
MAVEN_TEST_TIMEOUT=900
OPENREWRITE_TIMEOUT=1800

# Cache Settings
MAVEN_API_CACHE_TTL_HOURS=1
CLEAR_CACHE_ON_STARTUP=false

# Report Configuration
DEFAULT_REPORT_FORMAT=markdown
REPORT_OUTPUT_DIR=./reports
INCLUDE_AGENT_LOGS=true

# Security Settings
ENABLE_SANDBOX=false
RESTRICT_FILE_ACCESS=false
MAX_FILE_SIZE_MB=10